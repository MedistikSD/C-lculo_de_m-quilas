<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cotizador de Maquilas</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0f1117;
  --surface: #181c27;
  --surface2: #1f2435;
  --border: #2a3048;
  --accent: #4f8aff;
  --accent2: #00e5b0;
  --warn: #ff8c42;
  --text: #e8ecf4;
  --muted: #6b7494;
  --label: #9aa3c2;
  --mono: 'DM Mono', monospace;
  --sans: 'Sora', sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 14px;
  min-height: 100vh;
  padding: 32px 20px 60px;
}
.grid-bg {
  position: fixed; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(79,138,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(79,138,255,.04) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
}
.container { max-width: 860px; margin: 0 auto; position: relative; z-index: 1; }

/* Header */
header { margin-bottom: 36px; }
.eyebrow {
  font-family: var(--mono); font-size: 11px; letter-spacing: .12em;
  color: var(--accent); text-transform: uppercase; margin-bottom: 8px;
}
h1 { font-size: 28px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; }
h1 span { color: var(--accent2); }
.subtitle { color: var(--muted); font-size: 13px; margin-top: 6px; font-weight: 300; }

/* Cards */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 16px;
}
.card-title {
  font-family: var(--mono); font-size: 10px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--accent); margin-bottom: 20px;
  display: flex; align-items: center; gap: 8px;
}
.card-title::after {
  content: ''; flex: 1; height: 1px; background: var(--border);
}

/* Grid layouts */
.g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.g3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
.g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
@media(max-width:600px) { .g2,.g3,.g4 { grid-template-columns: 1fr; } }

/* Form fields */
.field { display: flex; flex-direction: column; gap: 6px; }
label {
  font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--label);
}
input[type=number], select {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 7px; color: var(--text);
  font-family: var(--mono); font-size: 15px;
  padding: 10px 13px; width: 100%; outline: none;
  transition: border-color .15s;
  -moz-appearance: textfield;
}
input[type=number]::-webkit-outer-spin-button,
input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; }
input[type=number]:focus, select:focus { border-color: var(--accent); }
select option { background: var(--surface2); }

/* Slider */
.slider-row { display: flex; align-items: center; gap: 10px; }
input[type=range] {
  -webkit-appearance: none; appearance: none;
  flex: 1; height: 4px;
  background: var(--border); border-radius: 2px; outline: none;
}
input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 16px; height: 16px;
  border-radius: 50%; background: var(--accent); cursor: pointer;
  border: 2px solid var(--bg);
}
input[type=range]::-moz-range-thumb {
  width: 16px; height: 16px; border-radius: 50%;
  background: var(--accent); cursor: pointer; border: 2px solid var(--bg);
}
.slider-val {
  font-family: var(--mono); font-size: 13px;
  color: var(--accent); min-width: 42px; text-align: right;
}

/* Toggle chips */
.chips { display: flex; gap: 8px; flex-wrap: wrap; }
.chip {
  padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600;
  border: 1px solid var(--border); cursor: pointer; transition: all .15s;
  background: var(--surface2); color: var(--muted); font-family: var(--mono);
  letter-spacing: .04em;
}
.chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }

/* Result metrics */
.results-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; }
.metric {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 10px; padding: 16px;
}
.metric .mlabel {
  font-family: var(--mono); font-size: 9px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 6px;
}
.metric .mval {
  font-family: var(--mono); font-size: 22px; font-weight: 500; color: var(--text);
  line-height: 1;
}
.metric .msub { font-size: 11px; color: var(--muted); margin-top: 4px; }
.metric.highlight { border-color: var(--accent2); background: rgba(0,229,176,.06); }
.metric.highlight .mval { color: var(--accent2); }
.metric.warn-m { border-color: var(--warn); background: rgba(255,140,66,.06); }
.metric.warn-m .mval { color: var(--warn); }

/* Price breakdown */
.breakdown {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; margin-top: 16px;
}
.brow {
  display: flex; justify-content: space-between; align-items: center;
  padding: 11px 16px; border-bottom: 1px solid var(--border);
  font-size: 13px;
}
.brow:last-child { border-bottom: none; }
.brow .blbl { color: var(--label); }
.brow .bval { font-family: var(--mono); font-weight: 500; }
.brow.total { background: rgba(79,138,255,.07); }
.brow.total .blbl { color: var(--text); font-weight: 600; }
.brow.total .bval { color: var(--accent); font-size: 16px; }

/* Productivity ref table */
.ref-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.ref-table th {
  font-family: var(--mono); font-size: 9px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--muted); text-align: left;
  padding: 8px 12px; border-bottom: 1px solid var(--border);
}
.ref-table td { padding: 8px 12px; border-bottom: 1px solid rgba(42,48,72,.5); color: var(--label); }
.ref-table tr:last-child td { border-bottom: none; }
.ref-table td:nth-child(n+3) { font-family: var(--mono); text-align: right; }
.ref-table .td-proc { font-weight: 600; color: var(--text); }
.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }

/* Ramp section */
.ramp-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-top: 4px; }
.ramp-card {
  border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px;
  background: var(--surface2);
}
.ramp-card .rt { font-family: var(--mono); font-size: 9px; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 6px; }
.ramp-card .rv { font-size: 18px; font-weight: 700; color: var(--text); font-family: var(--mono); }
.ramp-card .rs { font-size: 11px; color: var(--muted); margin-top: 3px; }
.ramp-card.f1 { border-color: rgba(0,229,176,.3); }
.ramp-card.f2 { border-color: rgba(79,138,255,.3); }
.ramp-card.f3 { border-color: rgba(255,140,66,.3); }

/* Warning box */
.warn-box {
  background: rgba(255,140,66,.08); border: 1px solid rgba(255,140,66,.3);
  border-radius: 8px; padding: 12px 16px; font-size: 12px;
  color: var(--warn); margin-top: 14px; display: none;
}

/* Divider */
.sep { border: none; border-top: 1px solid var(--border); margin: 6px 0 20px; }

/* Animate in */
@keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
.card { animation: fadeUp .3s ease both; }
.card:nth-child(2) { animation-delay: .06s; }
.card:nth-child(3) { animation-delay: .12s; }
.card:nth-child(4) { animation-delay: .18s; }
</style>
</head>
<body>
<div class="grid-bg"></div>
<div class="container">

<header>
  <div class="eyebrow">// Herramienta de cotización</div>
  <h1>Calculadora de <span>Maquilas</span></h1>
  <div class="subtitle">Cotización rápida por tipo de proceso · Overhead · Margen · Tarifa final</div>
</header>

<!-- PASO 1: TIPO Y VOLUMEN -->
<div class="card">
  <div class="card-title">01 — Producto y volumen</div>
  <div class="g2" style="margin-bottom:18px">
    <div class="field">
      <label>Tipo de proceso</label>
      <select id="tipo" onchange="update()">
        <option value="ET">Etiquetado y Empaque</option>
        <option value="AR">Armado de Cajilla – Charola Manual</option>
        <option value="HO">Horno de Retractilado</option>
      </select>
    </div>
    <div class="field">
      <label>Piezas por caja colectiva (estandar)</label>
      <input type="number" id="pzas_caja" value="288" min="1" onchange="update()">
    </div>
  </div>
  <div class="g2">
    <div class="field">
      <label>Volumen total (piezas)</label>
      <input type="number" id="volumen" value="10000" min="1" onchange="update()">
    </div>
    <div class="field">
      <label>Cajas colectivas totales</label>
      <input type="number" id="cajas" value="" placeholder="Auto-calculado" readonly
             style="opacity:.6;cursor:default">
    </div>
  </div>
</div>

<!-- PASO 2: PRODUCTIVIDAD -->
<div class="card">
  <div class="card-title">02 — Productividad (pzas / HH)</div>
  <div style="margin-bottom:16px">
    <div class="chips" id="prod-chips">
      <div class="chip active" onclick="selectProd('prom',this)">Promedio del proceso</div>
      <div class="chip" onclick="selectProd('med',this)">Mediana</div>
      <div class="chip" onclick="selectProd('cons',this)">Conservador (–15%)</div>
      <div class="chip" onclick="selectProd('custom',this)">Personalizado</div>
    </div>
  </div>
  <div class="g2">
    <div class="field">
      <label>Productividad usada (pzas/HH)</label>
      <input type="number" id="prod_val" value="53.33" step="0.1" onchange="update()">
    </div>
    <div class="field">
      <label>HH requeridas (calculado)</label>
      <input type="number" id="hh_req" readonly style="opacity:.6;cursor:default">
    </div>
  </div>

  <div style="margin-top:18px">
    <div class="card-title" style="margin-bottom:12px">Referencia por proceso (datos reales de 30 productos)</div>
    <table class="ref-table">
      <thead>
        <tr>
          <th>Proceso</th>
          <th>N prods</th>
          <th>Promedio</th>
          <th>Mediana</th>
          <th>Rango</th>
          <th>$/HH prom.</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-proc"><span class="dot" style="background:#4f8aff"></span>Etiquetado y Empaque</td>
          <td>19</td><td>53.33</td><td>46.30</td><td>26.70 – 88.54</td><td>$71.67</td>
        </tr>
        <tr>
          <td class="td-proc"><span class="dot" style="background:#00e5b0"></span>Armado de Cajilla</td>
          <td>3</td><td>32.53</td><td>31.95</td><td>31.91 – 33.72</td><td>$90.89</td>
        </tr>
        <tr>
          <td class="td-proc"><span class="dot" style="background:#ff8c42"></span>Horno Retractilado</td>
          <td>8</td><td>37.98</td><td>31.85</td><td>26.42 – 58.93</td><td>$76.17</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- PASO 3: COSTOS Y VARIABLES -->
<div class="card">
  <div class="card-title">03 — Estructura de costos</div>
  <div class="g3" style="margin-bottom:20px">
    <div class="field">
      <label>Costo FTE mensual ($)</label>
      <input type="number" id="costo_fte" value="23750" onchange="update()">
    </div>
    <div class="field">
      <label>FTEs asignados</label>
      <input type="number" id="ftes" value="55" min="1" onchange="update()">
    </div>
    <div class="field">
      <label>Horas productivas / turno</label>
      <input type="number" id="hp" value="7.3" step="0.1" onchange="update()">
    </div>
  </div>

  <hr class="sep">

  <div style="margin-bottom:16px">
    <label style="display:block;margin-bottom:10px">Overhead — x × (1 + y)</label>
    <div class="slider-row">
      <input type="range" id="overhead_sl" min="0" max="50" value="20" step="1"
             oninput="document.getElementById('overhead_v').value=this.value;update()">
      <div class="slider-val" id="overhead_sv">20%</div>
      <input type="number" id="overhead_v" value="20" min="0" max="100" style="width:70px"
             onchange="document.getElementById('overhead_sl').value=this.value;update()">
      <span style="color:var(--muted);font-size:12px">%</span>
    </div>
    <div style="font-size:11px;color:var(--muted);margin-top:6px">
      Incluye: instalaciones, supervisión, materiales indirectos, administración
    </div>
  </div>

  <hr class="sep">

  <div>
    <label style="display:block;margin-bottom:10px">Margen de utilidad — x / (1 − y)</label>
    <div class="slider-row">
      <input type="range" id="margen_sl" min="0" max="60" value="25" step="1"
             oninput="document.getElementById('margen_v').value=this.value;update()">
      <div class="slider-val" id="margen_sv">25%</div>
      <input type="number" id="margen_v" value="25" min="0" max="99" style="width:70px"
             onchange="document.getElementById('margen_sl').value=this.value;update()">
      <span style="color:var(--muted);font-size:12px">%</span>
    </div>
    <div style="font-size:11px;color:var(--muted);margin-top:6px">
      Precio = Costo total / (1 − margen%)
    </div>
  </div>
</div>

<!-- RESULTADOS -->
<div class="card" id="results-card">
  <div class="card-title">04 — Resultado de cotización</div>

  <div class="results-grid" style="margin-bottom:16px">
    <div class="metric">
      <div class="mlabel">HH requeridas</div>
      <div class="mval" id="r_hh">—</div>
      <div class="msub" id="r_hh_sub"></div>
    </div>
    <div class="metric">
      <div class="mlabel">Costo base mano de obra</div>
      <div class="mval" id="r_costo_base">—</div>
      <div class="msub" id="r_costo_base_sub"></div>
    </div>
    <div class="metric">
      <div class="mlabel">Costo + overhead</div>
      <div class="mval" id="r_costo_oh">—</div>
      <div class="msub">Incluye carga indirecta</div>
    </div>
    <div class="metric">
      <div class="mlabel">Tiempo de entrega</div>
      <div class="mval" id="r_tiempo">—</div>
      <div class="msub" id="r_tiempo_sub"></div>
    </div>
    <div class="metric highlight" style="grid-column:1/-1">
      <div class="mlabel">Precio de venta (facturación estimada)</div>
      <div class="mval" id="r_precio">—</div>
      <div class="msub" id="r_precio_sub"></div>
    </div>
  </div>

  <div class="breakdown">
    <div class="brow"><span class="blbl">Costo MO por HH</span><span class="bval" id="b_costo_hh">—</span></div>
    <div class="brow"><span class="blbl">Costo base (HH × $/HH)</span><span class="bval" id="b_base">—</span></div>
    <div class="brow"><span class="blbl">Overhead (<span id="b_oh_pct">0</span>%)</span><span class="bval" id="b_oh">—</span></div>
    <div class="brow"><span class="blbl">Costo total</span><span class="bval" id="b_total">—</span></div>
    <div class="brow"><span class="blbl">Utilidad (<span id="b_mg_pct">0</span>%)</span><span class="bval" id="b_util">—</span></div>
    <div class="brow total">
      <span class="blbl">💰 Precio de venta total</span>
      <span class="bval" id="b_precio_total">—</span>
    </div>
    <div class="brow total" style="background:rgba(0,229,176,.07)">
      <span class="blbl" style="color:var(--accent2)">★ Tarifa por pieza</span>
      <span class="bval" style="color:var(--accent2);font-size:20px" id="b_tarifa">—</span>
    </div>
    <div class="brow" style="background:rgba(0,229,176,.03)">
      <span class="blbl" style="color:var(--muted)">Ref. mercado</span>
      <span class="bval" id="b_mercado" style="color:var(--muted)">—</span>
    </div>
  </div>

  <div class="warn-box" id="warn_bajo">
    ⚠️ La tarifa calculada está <strong>por debajo</strong> del precio de mercado de referencia. Considera ajustar el overhead o el margen, o revisar la productividad utilizada.
  </div>
  <div class="warn-box" id="warn_arriba" style="background:rgba(0,229,176,.07);border-color:rgba(0,229,176,.3);color:var(--accent2)">
    ✓ La tarifa calculada está <strong>por encima</strong> del precio de mercado — buena posición competitiva.
  </div>

  <hr class="sep" style="margin-top:20px">

  <!-- Rampeo -->
  <div class="card-title" style="margin-top:4px">Activación de turnos recomendada</div>
  <div class="ramp-grid">
    <div class="ramp-card f1">
      <div class="rt">Fase 1 — Solo 2do turno</div>
      <div class="rv" id="ramp_f1_hh">—</div>
      <div class="rs">HH/semana disponibles</div>
      <div class="rs" style="margin-top:4px;color:var(--accent2)" id="ramp_f1_ok"></div>
    </div>
    <div class="ramp-card f2">
      <div class="rt">Fase 2 — 1ro + 2do turno</div>
      <div class="rv" id="ramp_f2_hh">—</div>
      <div class="rs">HH/semana disponibles</div>
      <div class="rs" style="margin-top:4px;color:#4f8aff" id="ramp_f2_ok"></div>
    </div>
    <div class="ramp-card f3">
      <div class="rt">Fase 3 — 3 turnos completos</div>
      <div class="rv" id="ramp_f3_hh">—</div>
      <div class="rs">HH/semana disponibles</div>
      <div class="rs" style="margin-top:4px;color:var(--warn)" id="ramp_f3_ok"></div>
    </div>
  </div>
  <div style="font-size:11px;color:var(--muted);margin-top:10px">
    Turnos: 1ro 08–16 (14 pers.) · 2do 11–19 (28 pers.) · 3ro 21–05 (13 pers.) · Sáb solo 2do · 7.3 h productivas/turno
  </div>
</div>

</div><!-- /container -->

<script>
const PROC = {
  ET: { nombre:'Etiquetado y Empaque', prom:53.33, med:46.30, costo_hh:71.67, mercado:2.30 },
  AR: { nombre:'Armado de Cajilla',    prom:32.53, med:31.95, costo_hh:90.89, mercado:4.50 },
  HO: { nombre:'Horno Retractilado',   prom:37.98, med:31.85, costo_hh:76.17, mercado:11.00 },
};
let prodMode = 'prom';

function selectProd(mode, el) {
  prodMode = mode;
  document.querySelectorAll('#prod-chips .chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  applyProdMode();
  update();
}

function applyProdMode() {
  const tipo = document.getElementById('tipo').value;
  const p = PROC[tipo];
  const inp = document.getElementById('prod_val');
  if (prodMode === 'prom')   { inp.value = p.prom.toFixed(2); inp.readOnly = true; inp.style.opacity='.6'; }
  else if (prodMode === 'med')  { inp.value = p.med.toFixed(2);  inp.readOnly = true; inp.style.opacity='.6'; }
  else if (prodMode === 'cons') { inp.value = (p.prom*0.85).toFixed(2); inp.readOnly = true; inp.style.opacity='.6'; }
  else { inp.readOnly = false; inp.style.opacity='1'; }
}

function fmt(n, dec=0) {
  return n.toLocaleString('es-MX', {minimumFractionDigits:dec, maximumFractionDigits:dec});
}
function fmtM(n) { return '$' + fmt(n,0); }
function fmtD(n, dec=2) { return '$' + fmt(n,dec); }

function update() {
  const tipo     = document.getElementById('tipo').value;
  const p        = PROC[tipo];
  const volumen  = parseFloat(document.getElementById('volumen').value) || 0;
  const pzas_caja= parseFloat(document.getElementById('pzas_caja').value) || 1;
  const prod     = parseFloat(document.getElementById('prod_val').value) || p.prom;
  const oh_pct   = parseFloat(document.getElementById('overhead_v').value) || 0;
  const mg_pct   = parseFloat(document.getElementById('margen_v').value) || 0;
  const costo_fte= parseFloat(document.getElementById('costo_fte').value) || 23750;
  const ftes     = parseFloat(document.getElementById('ftes').value) || 55;
  const hp       = parseFloat(document.getElementById('hp').value) || 7.3;

  // Turnos fijos
  const t1=14, t2=28, t3=13;
  const hh_sem_f1 = t2*hp*6;
  const hh_sem_f2 = (t1+t2)*hp*5 + t2*hp;
  const hh_sem_f3 = (t1+t2+t3)*hp*5 + t2*hp;

  // Cajas
  const cajas = volumen / pzas_caja;
  document.getElementById('cajas').value = fmt(cajas,2);

  // Aplicar modo productividad si no es custom
  if (prodMode !== 'custom') applyProdMode();

  // HH requeridas
  const hh = prod > 0 ? volumen / prod : 0;
  document.getElementById('hh_req').value = fmt(hh,2);
  document.getElementById('prod_val').value = prod.toFixed(2);

  // Costo mano de obra
  // Costo/HH basado en nómina proporcional
  const hh_mes_fte = hp * 26; // HH/mes por FTE (L-S)
  const costo_hh_nom = costo_fte / hh_mes_fte; // $/HH real de nómina
  const costo_base = hh * costo_hh_nom;
  const costo_oh   = costo_base * (1 + oh_pct/100);
  const precio     = mg_pct < 100 ? costo_oh / (1 - mg_pct/100) : 0;
  const utilidad   = precio - costo_oh;
  const tarifa     = volumen > 0 ? precio / volumen : 0;

  // Tiempo entrega
  const hh_dia = ftes * hp;
  const dias   = hh_dia > 0 ? hh / hh_dia : 0;
  const sems   = dias / 6;
  const meses  = dias / 26;

  // Sliders label sync
  document.getElementById('overhead_sv').textContent = oh_pct + '%';
  document.getElementById('margen_sv').textContent   = mg_pct + '%';

  // Resultados
  document.getElementById('r_hh').textContent        = fmt(hh,1) + ' HH';
  document.getElementById('r_hh_sub').textContent    = fmt(volumen,0) + ' pzas ÷ ' + fmt(prod,2) + ' pzas/HH';
  document.getElementById('r_costo_base').textContent= fmtM(costo_base);
  document.getElementById('r_costo_base_sub').textContent = fmtD(costo_hh_nom,2) + '/HH × ' + fmt(hh,1) + ' HH';
  document.getElementById('r_costo_oh').textContent  = fmtM(costo_oh);
  document.getElementById('r_tiempo').textContent    = fmt(sems,1) + ' semanas';
  document.getElementById('r_tiempo_sub').textContent= fmt(dias,1) + ' días hábiles · ' + fmt(meses,2) + ' meses';
  document.getElementById('r_precio').textContent    = fmtM(precio);
  document.getElementById('r_precio_sub').textContent= 'Margen ' + mg_pct + '% · Overhead ' + oh_pct + '%';

  // Breakdown
  document.getElementById('b_costo_hh').textContent  = fmtD(costo_hh_nom,2) + '/HH';
  document.getElementById('b_base').textContent      = fmtM(costo_base);
  document.getElementById('b_oh_pct').textContent    = oh_pct;
  document.getElementById('b_oh').textContent        = fmtM(costo_oh - costo_base);
  document.getElementById('b_total').textContent     = fmtM(costo_oh);
  document.getElementById('b_mg_pct').textContent    = mg_pct;
  document.getElementById('b_util').textContent      = fmtM(utilidad);
  document.getElementById('b_precio_total').textContent = fmtM(precio);
  document.getElementById('b_tarifa').textContent    = fmtD(tarifa,4) + '/pz';
  document.getElementById('b_mercado').textContent   = 'Ref. mercado: ' + fmtD(p.mercado,2) + '/pz';

  // Warnings
  const wBajo   = document.getElementById('warn_bajo');
  const wArriba = document.getElementById('warn_arriba');
  wBajo.style.display   = tarifa > 0 && tarifa < p.mercado  ? 'block' : 'none';
  wArriba.style.display = tarifa > 0 && tarifa >= p.mercado ? 'block' : 'none';

  // Rampeo
  const hh_total = hh;
  const sem_f1 = hh_sem_f1 > 0 ? (hh_total/hh_sem_f1).toFixed(1) : '—';
  const sem_f2 = hh_sem_f2 > 0 ? (hh_total/hh_sem_f2).toFixed(1) : '—';
  const sem_f3 = hh_sem_f3 > 0 ? (hh_total/hh_sem_f3).toFixed(1) : '—';
  document.getElementById('ramp_f1_hh').textContent = fmt(hh_sem_f1,1) + ' HH';
  document.getElementById('ramp_f2_hh').textContent = fmt(hh_sem_f2,1) + ' HH';
  document.getElementById('ramp_f3_hh').textContent = fmt(hh_sem_f3,1) + ' HH';
  document.getElementById('ramp_f1_ok').textContent = `→ ${sem_f1} semanas en Fase 1`;
  document.getElementById('ramp_f2_ok').textContent = `→ ${sem_f2} semanas en Fase 2`;
  document.getElementById('ramp_f3_ok').textContent = `→ ${sem_f3} semanas en Fase 3`;
}

// Init
update();
</script>
</body>
</html>
